# Shared backend settings
LUNA_DEMO_USER_ID=11111111-1111-1111-1111-111111111111

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (optional — without a key the local heuristic provider is used)
OPENAI_API_KEY=
LUNA_QUIZ_MODEL=          # default gpt-4o-mini
LUNA_AGENT_MODEL=         # default from AGENT_MODEL_OPTIONS in pipeline/agentBuilder.js
LUNA_EMBEDDING_MODEL=     # default text-embedding-3-small

# Math OCR service (optional)
MATH_OCR_ENDPOINT=
MATH_OCR_APP_ID=
MATH_OCR_APP_KEY=

# Document extraction tuning (optional)
OCR_LANGUAGES=            # e.g. eng+spa
OCR_MIN_CONFIDENCE=
EXTRACTION_MIN_CONFIDENCE=
