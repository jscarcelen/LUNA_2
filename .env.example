# Shared backend settings
LUNA_DEMO_USER_ID=11111111-1111-1111-1111-111111111111

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Accounts: signs the session cookie. 32+ random characters (openssl rand -base64 48).
# Required in production/preview; locally a development value is used when empty.
LUNA_SESSION_SECRET=

# Accounts: outgoing email (confirm email, reset password, connection requests). Pick ONE option.
# Without either, development prints each email (subject + link) to the server console; production sends
# nothing and the UI says "Email is not set up yet" (log in and sign up still work).
LUNA_MAIL_FROM=                # e.g. Luna <noreply@yourdomain.com> (Gmail: your own address)
LUNA_PUBLIC_URL=               # e.g. https://luna.example.com - the address links in emails point to (set it in production)
# Option A, SMTP (no domain needed): Gmail with an app password, Brevo, Mailtrap...
#   Gmail: Google Account > Security > turn on 2-Step Verification > App passwords > create one for "Luna";
#   then smtps://you%40gmail.com:the-16-letter-app-password@smtp.gmail.com:465 (encode @ as %40).
#   LUNA_MAIL_FROM must be that Gmail address. Gmail allows roughly 500 messages a day.
LUNA_SMTP_URL=
# Option B, Resend REST API (https://resend.com). Needs a verified domain for LUNA_MAIL_FROM; the test
# sender onboarding@resend.dev only delivers to the email address of your own Resend account.
# If LUNA_SMTP_URL is also set, SMTP wins.
RESEND_API_KEY=

# OpenAI (optional — without a key the local heuristic provider is used)
OPENAI_API_KEY=
LUNA_QUIZ_MODEL=          # default gpt-4o-mini
LUNA_AGENT_MODEL=         # default from AGENT_MODEL_OPTIONS in pipeline/agentBuilder.js
LUNA_EMBEDDING_MODEL=     # default text-embedding-3-small

# Math OCR service (optional)
MATH_OCR_ENDPOINT=
MATH_OCR_APP_ID=
MATH_OCR_APP_KEY=

# Document extraction tuning (optional)
OCR_LANGUAGES=            # e.g. eng+spa
OCR_MIN_CONFIDENCE=
EXTRACTION_MIN_CONFIDENCE=
