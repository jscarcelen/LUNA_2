{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @luna/web -- --webpack",
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/privacy",
      "schedule": "0 3 * * *"
    }
  ]
}
